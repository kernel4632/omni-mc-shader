# 项目内下载的工具、游戏环境与本机路径。
.dev/
.venv/
dist/
__pycache__/
*.pyc
*.rdc
*.log

# 用户提供的完整参考光影只用于本地研究。
/references/

# 这些文件由 build.py 生成，来源在效果和绘制设置中。
shaders/shaders.properties
shaders/lang/*.lang

# 编辑器的个人状态。
.idea/
.vscode/*.local.json

# 浏览器工具的本机输出，不属于项目源码。
.playwright-mcp/

# omni-gfx 的 SPIR-V 与清单是本机可复现产物，二进制不入仓库。
omni-gfx/generated/spirv/**/*.spv
omni-gfx/generated/spirv/manifest.json
