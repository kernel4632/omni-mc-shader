#include "../../src/cloud_eclipse.slang"

[shader("fragment")]
float4 probeMain(float4 position : SV_Position) : SV_Target
{
    float t = position.x * 0.001 + 0.25; // ??????
    float2 hash = ogxEclipseHash2(float2(t, t * 2.0)); // ???
    float2 curl = ogxEclipseCurl2D(float2(t, t * 3.0)); // ???
    float planet = ogxEclipseGetPlanetShadow(float3(t, 10.0, 0.0), normalize(float3(0.2, 0.5, 0.3))); // ?????
    float phase = ogxEclipsePhaseCloud(t, 0.6, 0); // ????
    return float4(hash + curl + planet + phase, 1.0); // ??????
}
