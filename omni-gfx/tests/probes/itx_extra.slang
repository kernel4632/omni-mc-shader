#include "../../src/itx_extra.slang"

[shader("fragment")]
float4 probeMain(float4 position : SV_Position) : SV_Target
{
    float t = position.x * 0.001 + 0.25; // ??????
    float3 noisy = ogxDhNoise(float3(t, 0.4, 0.8), float3(t, 0.1, 0.2), 4.0, 4, 8.0, 0.3); // ?????
    float4x4 portal = ogxEndPortalLayer(t + 1.0, t * 100.0); // ?????
    return float4(noisy + portal[3].xyz, 1.0); // ??????
}
