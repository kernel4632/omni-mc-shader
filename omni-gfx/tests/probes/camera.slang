#include "../../src/camera.slang"

[shader("fragment")]
float4 probeMain(float4 position : SV_Position) : SV_Target
{
    float t = position.x * 0.001 + 0.25; // ??????
    float4x4 m = float4x4(1.0); // ???????
    float3 view = ogxViewPosFromScreenPos(float2(t, t), t, float2(0.0), 0.5, m, false); // ????
    float3 screen = ogxScreenPosFromViewPos(view, float2(0.0), 0.5, m, false); // ???
    float3 clip = ogxProjectAndDivide(m, view); // ?????
    return float4(screen + clip, 1.0); // ??????
}
