#include "../../src/eclipse_extra.slang"

[shader("fragment")]
float4 probeMain(float4 position : SV_Position) : SV_Target
{
    float t = position.x * 0.001 + 0.25; // ??????
    float phase = ogxEclipseFogPhase(t); // ????
    float3x3 rotation = ogxEclipseCustomRotation(t * 10.0, t * 24000.0); // ?????
    float3 sphere = ogxEclipseCartToSphere(float2(t, t)); // ?????
    return float4(sphere + rotation[0] * phase, 1.0); // ??????
}
