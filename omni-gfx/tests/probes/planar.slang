#include "../../src/planar.slang"

[shader("fragment")]
float4 probeMain(float4 position : SV_Position) : SV_Target
{
    float t = position.x * 0.001 + 0.25; // ??????
    float2 hit = ogxRaySphereIntersection(float3(0.0, 6360.0, 0.0), normalize(float3(t, 0.2, 0.8)), 6361.0); // ?????
    return float4(hit, t, 1.0); // ??????
}
