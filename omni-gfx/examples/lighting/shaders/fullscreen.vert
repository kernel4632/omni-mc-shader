#version 330 core
// 全屏三角形顶点阶段：不绑定顶点缓冲，直接用顶点编号铺满屏幕。
// 调用位置：天空、体积云、全局光、合成、雾、抗锯齿、泛光、曝光与后期。
// 设计原因与取舍：三个顶点覆盖整个裁剪空间，省掉全屏四边形与索引缓冲；
// 片元阶段用 `gl_FragCoord` 还原像素坐标，所有全屏阶段共用同一套约定。
void main()
{
    vec2 corner = vec2(float((gl_VertexID << 1) & 2), float(gl_VertexID & 2));  // 三个顶点覆盖屏幕。
    gl_Position = vec4(corner * 2.0 - 1.0, 0.0, 1.0);  // 零到二映射到裁剪空间负一到一。
}
